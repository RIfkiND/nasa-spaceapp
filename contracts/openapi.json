{
  "openapi": "3.1.0",
  "info": {
    "title": "Field Shift API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_HealthData_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rotations/sites": {
      "get": {
        "tags": [
          "rotations"
        ],
        "summary": "Sites",
        "operationId": "sites_api_v1_rotations_sites_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_list_SiteInfo__"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rotations/compare": {
      "post": {
        "tags": [
          "rotations"
        ],
        "summary": "Compare Rotations",
        "operationId": "compare_rotations_api_v1_rotations_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_ComparisonOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalogsOut": {
        "properties": {
          "grouping": {
            "type": "string",
            "title": "Grouping"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "years": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Years"
          }
        },
        "type": "object",
        "required": [
          "grouping",
          "phase",
          "years"
        ],
        "title": "AnalogsOut"
      },
      "ApiResponse_ComparisonOut_": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ComparisonOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageMeta"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "ApiResponse[ComparisonOut]"
      },
      "ApiResponse_HealthData_": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HealthData"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageMeta"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "ApiResponse[HealthData]"
      },
      "ApiResponse_list_SiteInfo__": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "data": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SiteInfo"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageMeta"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "ApiResponse[list[SiteInfo]]"
      },
      "CompareRequest": {
        "properties": {
          "site": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$",
            "title": "Site",
            "examples": [
              "nevada_mason_valley"
            ]
          },
          "priorities": {
            "$ref": "#/components/schemas/Priorities"
          },
          "risk_aversion": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Aversion",
            "description": "0 = average years only, 1 = worst 20 % only",
            "default": 0.5
          },
          "enso_phase": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "el_nino",
                  "la_nina",
                  "neutral"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Enso Phase",
            "description": "Default: latest observed"
          },
          "iod_phase": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "neutral"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Iod Phase",
            "description": "Default: latest observed"
          },
          "baseline": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array",
                "maxItems": 10,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline",
            "description": "Farmer's current rotation: one {season: crop} object per year; seasons left out are fallow. Replaces the default baseline."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site"
        ],
        "title": "CompareRequest"
      },
      "ComparisonOut": {
        "properties": {
          "site": {
            "type": "string",
            "title": "Site"
          },
          "analogs": {
            "$ref": "#/components/schemas/AnalogsOut"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Weights"
          },
          "risk_aversion": {
            "type": "number",
            "title": "Risk Aversion"
          },
          "strategies": {
            "items": {
              "$ref": "#/components/schemas/StrategyOut"
            },
            "type": "array",
            "title": "Strategies"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "type": "object",
        "required": [
          "site",
          "analogs",
          "weights",
          "risk_aversion",
          "strategies",
          "disclaimer"
        ],
        "title": "ComparisonOut"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable machine-readable error code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable message, safe to show to users"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "Field-level validation details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "EvidenceCardOut": {
        "properties": {
          "why": {
            "type": "string",
            "title": "Why"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence"
          },
          "benefits": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Benefits"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gaps"
          },
          "risks_for_local_review": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Risks For Local Review"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Confidence"
          },
          "confidence_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Confidence Reasons"
          }
        },
        "type": "object",
        "required": [
          "why",
          "evidence",
          "benefits",
          "gaps",
          "risks_for_local_review",
          "confidence",
          "confidence_reasons"
        ],
        "title": "EvidenceCardOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthData": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "env": {
            "type": "string",
            "title": "Env"
          }
        },
        "type": "object",
        "required": [
          "status",
          "env"
        ],
        "title": "HealthData"
      },
      "MetricsOut": {
        "properties": {
          "irrigation_mean_mm": {
            "type": "number",
            "title": "Irrigation Mean Mm"
          },
          "irrigation_cvar_mm": {
            "type": "number",
            "title": "Irrigation Cvar Mm"
          },
          "cover_share": {
            "type": "number",
            "title": "Cover Share"
          },
          "legume_share": {
            "type": "number",
            "title": "Legume Share"
          },
          "families": {
            "type": "integer",
            "title": "Families"
          },
          "pest_break_share": {
            "type": "number",
            "title": "Pest Break Share"
          },
          "erosion_index": {
            "type": "number",
            "title": "Erosion Index"
          },
          "soil_health": {
            "type": "number",
            "title": "Soil Health"
          }
        },
        "type": "object",
        "required": [
          "irrigation_mean_mm",
          "irrigation_cvar_mm",
          "cover_share",
          "legume_share",
          "families",
          "pest_break_share",
          "erosion_index",
          "soil_health"
        ],
        "title": "MetricsOut"
      },
      "PageMeta": {
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "limit": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Limit"
          }
        },
        "type": "object",
        "required": [
          "total",
          "page",
          "limit"
        ],
        "title": "PageMeta"
      },
      "Priorities": {
        "properties": {
          "water": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Water",
            "description": "Weight for low irrigation need",
            "default": 1.0
          },
          "soil_health": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Soil Health",
            "default": 1.0
          },
          "erosion": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Erosion",
            "description": "Weight for low erosion exposure",
            "default": 1.0
          },
          "pest_break": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Pest Break",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Priorities"
      },
      "SiteInfo": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "seasons": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Seasons"
          },
          "crops": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Crops"
          },
          "latest_enso_phase": {
            "type": "string",
            "title": "Latest Enso Phase"
          },
          "latest_iod_phase": {
            "type": "string",
            "title": "Latest Iod Phase"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name",
          "seasons",
          "crops",
          "latest_enso_phase",
          "latest_iod_phase",
          "sources"
        ],
        "title": "SiteInfo"
      },
      "StrategyOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "baseline",
              "alternative"
            ],
            "title": "Kind"
          },
          "sequence": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Sequence"
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricsOut"
          },
          "utilities": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Utilities"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "pareto_optimal": {
            "type": "boolean",
            "title": "Pareto Optimal"
          },
          "card": {
            "$ref": "#/components/schemas/EvidenceCardOut"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name",
          "kind",
          "sequence",
          "metrics",
          "utilities",
          "score",
          "rank",
          "pareto_optimal",
          "card"
        ],
        "title": "StrategyOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
