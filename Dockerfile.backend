FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Install dependencies first to maximize Docker layer cache reuse
COPY pyproject.toml README.md ./
RUN mkdir -p app && touch app/__init__.py && pip install --no-cache-dir .

# 2. Copy source code, pre-trained models, datasets, and scripts
COPY app ./app
COPY scripts ./scripts
COPY models ./models
COPY datasets ./datasets

# Re-install root package in editable/installed mode quickly
RUN pip install --no-cache-dir --no-deps -e .

EXPOSE 8000

# Healthcheck to verify the FastAPI server is healthy
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:8000/docs || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]